{
  "name": "businessLibrary",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release:workspace-check": "node scripts/release/check-workspace-boundary.mjs",
    "release:preflight": "node scripts/release/check-release-state.mjs",
    "release:policy:init": "node scripts/release/package-policy.mjs init",
    "release:policy:check": "node scripts/release/package-policy.mjs check",
    "release:consumer:dry-run": "node scripts/release/tarball-consumer-dry-run.mjs",
    "release:test:independent": "node --test test/release/durable-release-state.test.mjs test/release/pack-directory-implementation.test.mjs test/release/partial-publication-recovery.test.mjs test/release/verification-manifest-implementation.test.mjs test/release/workflow-policy.test.mjs test/release/workspace-package-contract.test.mjs",
    "release:test": "node --test test/release/*.test.mjs packages/yakit-ui/test/release/*.test.mjs",
    "test:auto-import": "node --test test/auto-import/*.test.mjs",
    "release:dry-run": "pnpm run release:workspace-check && pnpm run release:test && pnpm --filter @yakit-libs/yakit-ui-icons run build && pnpm --filter @yakit-libs/yakit-ui run build:package && pnpm run test:auto-import && pnpm --filter @yakit-libs/yakit-ui run verify:package && pnpm run release:policy:check && pnpm run release:consumer:dry-run && pnpm --filter @yakit-libs/yakit-ui run pack:dry-run && pnpm --filter @yakit-libs/yakit-ui-icons pack --dry-run",
    "icons:update": "node scripts/icons/update.mjs",
    "icons:import": "node packages/yakit-ui-icons/scripts/import-icon-sources.mjs",
    "icons:test": "pnpm --filter @yakit-libs/yakit-ui-icons run test:workflow && node --test test/icons/*.test.mjs",
    "icons:verify-isolation": "node scripts/icons/verify-isolation.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.11.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  }
}
