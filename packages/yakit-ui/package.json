{
  "name": "@yakit-libs/yakit-ui",
  "private": false,
  "version": "0.2.3",
  "description": "Yakit React component library with a version-matched offline Storybook.",
  "keywords": [
    "@yakit-libs/yakit-ui",
    "@yakit-libs",
    "react",
    "component-library"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "storybook-static",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "browser": "./dist/browser/icons/index.js",
      "import": "./dist/icons/index.js"
    },
    "./icons/outline": {
      "types": "./dist/icons/outline/index.d.ts",
      "browser": "./dist/browser/icons/outline/index.js",
      "import": "./dist/icons/outline/index.js"
    },
    "./icons/solid": {
      "types": "./dist/icons/solid/index.d.ts",
      "browser": "./dist/browser/icons/solid/index.js",
      "import": "./dist/icons/solid/index.js"
    },
    "./icons/colorful": {
      "types": "./dist/icons/colorful/index.d.ts",
      "browser": "./dist/browser/icons/colorful/index.js",
      "import": "./dist/icons/colorful/index.js"
    },
    "./icons/registry": {
      "types": "./dist/icons/registry.d.ts",
      "browser": "./dist/browser/icons/registry.js",
      "import": "./dist/icons/registry.js"
    },
    "./icons/icon.css": "./dist/icon.css",
    "./style.css": "./dist/index.css"
  },
  "bin": {
    "yakit-ui-storybook": "./dist/bin/yakit-ui-storybook.mjs"
  },
  "sideEffects": [
    "**/*.css",
    "dist/browser/**/*.js"
  ],
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaklang/yakit-components-library.git",
    "directory": "packages/yakit-ui"
  },
  "homepage": "https://github.com/yaklang/yakit-components-library/tree/main/packages/yakit-ui#readme",
  "bugs": {
    "url": "https://github.com/yaklang/yakit-components-library/issues"
  },
  "scripts": {
    "dev": "node scripts/dev-with-icons.mjs vite",
    "start:dev": "node scripts/dev-with-icons.mjs storybook dev -p 6006",
    "build": "pnpm --filter @yakit-libs/yakit-ui-icons run build && tsc -b && vite build",
    "generate:color-css": "yakit-color-css --theme Main --out src/styles/color.css",
    "build:lib": "pnpm --filter @yakit-libs/yakit-ui-icons run build && pnpm run generate:color-css && vite build --mode lib && tsc -p tsconfig.lib.json && node scripts/release/fix-declaration-imports.mjs",
    "build:package": "node scripts/release/build-package.mjs",
    "verify:package": "node scripts/release/verify-package.mjs",
    "test:release": "node --test test/release/*.test.mjs",
    "test:ssr-fixtures": "vitest run --config vitest.node.config.ts test/ssr/native-components-ssr.test.tsx",
    "test:ci": "pnpm --filter @yakit-libs/yakit-ui-icons run test:ci && pnpm run test:ssr-fixtures && vitest run --config vitest.config.ts && vitest run --config vitest.react18.config.ts",
    "release:dry-run": "pnpm run test:release && pnpm run build:package && pnpm run verify:package && pnpm run pack:dry-run",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepack": "node scripts/release/verify-package.mjs",
    "lint": "eslint src scripts .storybook test/icons test/components test/fixtures test/ssr test/types vite.config.ts vitest.config.ts vitest.node.config.ts vitest.react18.config.ts",
    "lint:fix": "eslint src scripts .storybook test/icons test/components test/fixtures test/ssr test/types vite.config.ts vitest.config.ts vitest.node.config.ts vitest.react18.config.ts --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:icon-dist-consumer": "pnpm --filter @yakit-libs/yakit-ui-icons run build && pnpm run build:lib && vitest run --config vitest.node.config.ts test/icons/dist-consumer.test.ts test/icons/icon-stroke-width-dist.test.ts test/icons/icon-adjustable-consumer.test.ts",
    "test:icon-package-contract": "tsc -p test/types/tsconfig.public.json --noEmit && vitest run --config vitest.node.config.ts test/icons/light-entry-contract.test.ts test/icons/dedicated-package-contract.test.ts",
    "test:types": "pnpm --filter @yakit-libs/yakit-ui-icons run test:types && tsc -p test/types/tsconfig.json --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,less,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,less,json,md}'",
    "storybook": "node scripts/dev-with-icons.mjs storybook dev -p 6006",
    "build-storybook": "pnpm --filter @yakit-libs/yakit-ui-icons run build && storybook build",
    "test:icon-integration": "vitest run --config vitest.node.config.ts test/icons/icon-storybook-contract.test.ts test/icons/oldicon-storybook-contract.test.ts",
    "icons:check-private": "node scripts/check-private-icons.mjs"
  },
  "dependencies": {
    "@yakit-libs/color": "1.4.1",
    "classnames": "^2.5.1",
    "antd": "^6.6.7",
    "@yakit-libs/yakit-ui-icons": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@eslint/js": "^9.25.0",
    "@storybook/addon-essentials": "8",
    "@storybook/addon-interactions": "8",
    "@storybook/addon-onboarding": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/builder-vite": "^8.6.14",
    "@storybook/experimental-addon-test": "8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/testing-library": "0.2.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^9.1.6",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.6",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "storybook": "8.6.14",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4",
    "react": "^19.1.0",
    "react-18": "npm:react@18.3.1",
    "react-dom": "^19.1.0",
    "react-dom-18": "npm:react-dom@18.3.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
