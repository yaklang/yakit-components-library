{
  "name": "@yakit-libs/yakit-ui-icons",
  "private": false,
  "version": "0.2.6",
  "description": "React-only icon package for Yakit UI.",
  "keywords": [
    "@yakit-libs/yakit-ui-icons",
    "@yakit-libs",
    "react",
    "icons"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js"
    },
    "./colorful": {
      "types": "./dist/colorful/index.d.ts",
      "browser": "./dist/browser/colorful/index.js",
      "import": "./dist/colorful/index.js"
    },
    "./outline": {
      "types": "./dist/outline/index.d.ts",
      "browser": "./dist/browser/outline/index.js",
      "import": "./dist/outline/index.js"
    },
    "./oldicon": {
      "types": "./dist/oldicon/index.d.ts",
      "browser": "./dist/browser/oldicon/index.js",
      "import": "./dist/oldicon/index.js"
    },
    "./oldicon/*": {
      "types": "./dist/oldicon/icons/*.d.ts",
      "browser": "./dist/browser/oldicon/icons/*.js",
      "import": "./dist/oldicon/icons/*.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "browser": "./dist/browser/solid/index.js",
      "import": "./dist/solid/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "browser": "./dist/browser/registry.js",
      "import": "./dist/registry.js"
    },
    "./icon.css": {
      "default": "./dist/icon.css"
    }
  },
  "sideEffects": [
    "**/*.css",
    "dist/browser/**/*.js"
  ],
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaklang/yakit-components-library.git",
    "directory": "packages/yakit-ui-icons"
  },
  "homepage": "https://github.com/yaklang/yakit-components-library/tree/main/packages/yakit-ui-icons#readme",
  "bugs": {
    "url": "https://github.com/yaklang/yakit-components-library/issues"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "measure:size": "node scripts/size-observability.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "pnpm run verify:package"
  },
  "dependencies": {
    "@yakit-libs/color": "1.4.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "0.25.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.5.0"
  }
}
