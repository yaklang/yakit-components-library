{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "test/main/**/*",
    "test/preload/**/*",
    "src/**/*",
    "src/preload/**/*"
  ],
  "exclude": ["scripts/index.ts"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "outDir": "dist/types"
  }
}
