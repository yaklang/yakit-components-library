{
  "name": "@yakit-libs/yakit-ui-icons",
  "private": false,
  "version": "0.3.3",
  "description": "React-only icon package for Yakit UI.",
  "keywords": [
    "@yakit-libs/yakit-ui-icons",
    "@yakit-libs",
    "react",
    "icons"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js"
    },
    "./colorful": {
      "types": "./dist/colorful/index.d.ts",
      "browser": "./dist/browser/colorful/index.js",
      "import": "./dist/colorful/index.js"
    },
    "./outline": {
      "types": "./dist/outline/index.d.ts",
      "browser": "./dist/browser/outline/index.js",
      "import": "./dist/outline/index.js"
    },
    "./oldicon": {
      "types": "./dist/oldicon/index.d.ts",
      "browser": "./dist/browser/oldicon/index.js",
      "import": "./dist/oldicon/index.js"
    },
    "./oldicon/*": {
      "types": "./dist/oldicon/icons/*.d.ts",
      "browser": "./dist/browser/oldicon/icons/*.js",
      "import": "./dist/oldicon/icons/*.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "browser": "./dist/browser/solid/index.js",
      "import": "./dist/solid/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "browser": "./dist/browser/registry.js",
      "import": "./dist/registry.js"
    },
    "./icon.css": {
      "default": "./dist/icon.css"
    }
  },
  "sideEffects": [
    "**/*.css",
    "dist/browser/**/*.js"
  ],
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaklang/yakit-components-library.git",
    "directory": "packages/yakit-ui-icons"
  },
  "homepage": "https://github.com/yaklang/yakit-components-library/tree/main/packages/yakit-ui-icons#readme",
  "bugs": {
    "url": "https://github.com/yaklang/yakit-components-library/issues"
  },
  "scripts": {
    "icons:check": "node scripts/check.mjs",
    "icons:import": "node scripts/import-icon-sources.mjs",
    "icons:update": "node scripts/update-icons.mjs",
    "audit:icons": "pnpm run audit:icons:assets && pnpm run audit:icons:outline && pnpm run audit:icons:solid && pnpm run audit:icons:colorful",
    "audit:icons:assets": "node scripts/check-icon-assets.mjs --check",
    "audit:icons:outline": "node config/generateIconStrokeContract.mjs --check && node scripts/audit-icons.mjs --check --policy outline-v1 --package-inputs",
    "audit:icons:solid": "node scripts/audit-icons.mjs --check --policy solid-v1 --package-inputs",
    "audit:icons:colorful": "node scripts/colorful-audit.mjs && node scripts/colorful-entry-generator.mjs",
    "test:workflow": "node scripts/test-workflow.mjs",
    "test:ci": "pnpm run test:node && pnpm run test:browser",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:browser": "vitest run --config vitest.config.ts",
    "test:types": "tsc -p test/types/tsconfig.json --noEmit",
    "watch": "node scripts/watch.mjs",
    "lint": "eslint src config scripts test vite.config.ts vitest.config.ts vitest.node.config.ts",
    "lint:fix": "eslint src config scripts test vite.config.ts vitest.config.ts vitest.node.config.ts --fix",
    "build": "vite build && tsc -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "pnpm run verify:package"
  },
  "dependencies": {
    "@yakit-libs/color": "1.4.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "0.25.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "playwright": "^1.65.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react-dom": "19.1.1",
    "prettier": "^3.6.2",
    "eslint": "^9.25.0",
    "@eslint/js": "^9.25.0",
    "typescript-eslint": "^8.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.2.0"
  }
}
